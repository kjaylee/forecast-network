            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "maximum": 10000,
          "minimum": 0
        },
        "brier_score_bp": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "maximum": 10000,
          "minimum": 0
        },
        "calibration_score_bp": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "maximum": 10000,
          "minimum": 0
        },
        "category": {
          "enum": [
            "TECHNOLOGY",
            "CRYPTO",
            "SCIENCE",
            "ENTERTAINMENT",
            "WORLD",
            "SPORTS",
            "OTHER"
