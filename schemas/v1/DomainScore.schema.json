          "minimum": 0,
          "type": "integer"
        },
        "total_forecasts": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "category",
        "total_forecasts",
        "resolved_forecasts",
        "correct_forecasts",
        "accuracy_bp",
        "brier_score_bp",
        "calibration_score_bp"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.forecast.network/v1/DomainScore.schema.json",
  "$ref": "#/$defs/DomainScore",
