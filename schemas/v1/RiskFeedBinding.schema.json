{
  "$comment": "Structural contract. Decode through the domain boundary to enforce semantic invariants.",
  "$defs": {
    "RiskFeedBinding": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "maxLength": 1000000,
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9]{0,15}$",
          "type": "string"
        },
        "binding_id": {
          "maxLength": 1000000,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "type": "string"
        },
        "category": {
          "enum": [
            "TECHNOLOGY",
            "CRYPTO",
            "SCIENCE",
            "ENTERTAINMENT",
            "WORLD",
            "SPORTS",
            "OTHER"
          ],
          "type": "string"
        },
        "channel": {
          "enum": [
            "depegRisk1d",
            "depegRisk7d",
            "depegRisk30d",
            "reserveLossRisk",
            "liquidityStressRisk",
            "stableCollateralRisk",
            "btcCrashRisk",
            "ethCrashRisk",
            "solCrashRisk",
            "oracleFailureRisk",
            "bridgeFailureRisk",
            "counterpartyRisk"
          ]
        },
        "forecast_id": {
          "maxLength": 1000000,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "type": "string"
        },
        "horizon_hours": {
          "maximum": 8760,
          "minimum": 1,
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "specification_hash": {
          "maxLength": 1000000,
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "valid_from_ms": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "valid_until_ms": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "version": {
          "const": "canonical-risk-binding-v1"
        }
      },
      "required": [
        "schema_version",
        "binding_id",
        "version",
        "forecast_id",
        "specification_hash",
        "channel",
        "horizon_hours",
        "asset",
        "category",
        "valid_from_ms",
        "valid_until_ms"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.forecast.network/v1/RiskFeedBinding.schema.json",
  "$ref": "#/$defs/RiskFeedBinding",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RiskFeedBinding"
}
