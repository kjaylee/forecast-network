{
  "$comment": "Structural contract. Decode through the domain boundary to enforce semantic invariants.",
  "$defs": {
    "ChannelCoverageV2": {
      "additionalProperties": false,
      "properties": {
        "binding_id": {
          "anyOf": [
            {
              "maxLength": 1000000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "channel": {
          "enum": [
            "depegRisk1d",
            "depegRisk7d",
            "depegRisk30d",
            "reserveLossRisk",
            "liquidityStressRisk",
            "stableCollateralRisk",
            "btcCrashRisk",
            "ethCrashRisk",
            "solCrashRisk",
            "oracleFailureRisk",
            "bridgeFailureRisk",
            "counterpartyRisk"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 1000000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "maxLength": 500
        },
        "schema_version": {
          "const": 1,
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "enum": [
            "covered",
            "unavailable",
            "saturated",
            "unsupported"
          ]
        }
      },
      "required": [
        "schema_version",
        "channel",
        "status",
        "binding_id",
        "reason"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.forecast.network/v1/ChannelCoverageV2.schema.json",
  "$ref": "#/$defs/ChannelCoverageV2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChannelCoverageV2"
}
