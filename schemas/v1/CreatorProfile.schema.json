{
  "$comment": "Structural contract. Decode through the domain boundary to enforce semantic invariants.",
  "$defs": {
    "CreatorProfile": {
      "additionalProperties": false,
      "properties": {
        "created_at_ms": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "creator_id": {
          "maxLength": 1000000,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])",
          "type": "string"
        },
        "creator_quality_bp": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "maximum": 10000,
          "minimum": 0
        },
        "disputed_markets": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "follower_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "invalid_markets": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "markets_created": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "resolved_markets": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "total_participation": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "updated_at_ms": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "creator_id",
        "markets_created",
        "resolved_markets",
        "invalid_markets",
        "disputed_markets",
        "total_participation",
        "follower_count",
        "creator_quality_bp",
        "created_at_ms",
        "updated_at_ms"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.forecast.network/v1/CreatorProfile.schema.json",
  "$ref": "#/$defs/CreatorProfile",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreatorProfile"
}
