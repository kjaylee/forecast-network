{
  "$comment": "Structural contract. Decode through the domain boundary to enforce semantic invariants.",
  "$defs": {
    "AIProvenance": {
      "additionalProperties": false,
      "properties": {
        "created_at_ms": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "input_hash": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "model": {
          "maxLength": 1000000,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "model_version": {
          "maxLength": 1000000,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "output_hash": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "policy_version": {
          "maxLength": 1000000,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "provider": {
          "maxLength": 1000000,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "task": {
          "enum": [
            "MARKET_COMPILER",
            "AMBIGUITY_JUDGE",
            "DUPLICATE_DETECTOR",
            "SOURCE_VERIFIER",
            "EVIDENCE_COLLECTOR",
            "RESOLUTION_JUDGE",
            "COUNTER_JUDGE",
            "DISPUTE_ANALYST",
            "INDEPENDENT_REJUDGE",
            "ADJUDICATION"
          ],
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "task",
        "provider",
        "model",
        "model_version",
        "policy_version",
        "input_hash",
        "output_hash",
        "created_at_ms"
      ],
      "type": "object"
    },
    "DisputeReview": {
      "additionalProperties": false,
      "properties": {
        "counter_analysis": {
          "$ref": "#/$defs/AIProvenance"
        },
        "disposition": {
          "enum": [
            "RETAIN_PROPOSAL",
            "MATERIAL_CONFLICT",
            "INVALID_EVIDENCE"
          ],
          "type": "string"
        },
        "dispute_hash": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "evidence_hash": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "evidence_validated": {
          "type": "boolean"
        },
        "evidence_validation": {
          "$ref": "#/$defs/AIProvenance"
        },
        "independent_judge": {
          "$ref": "#/$defs/AIProvenance"
        },
        "material_conflict": {
          "type": "boolean"
        },
        "reason_summary": {
          "maxLength": 1000000,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "resolution_hash": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "reviewed_at_ms": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "specification_hash": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "dispute_hash",
        "specification_hash",
        "resolution_hash",
        "evidence_hash",
        "evidence_validated",
        "material_conflict",
        "disposition",
        "evidence_validation",
        "counter_analysis",
        "independent_judge",
        "reason_summary",
        "reviewed_at_ms"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.forecast.network/v1/DisputeReview.schema.json",
  "$ref": "#/$defs/DisputeReview",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DisputeReview"
}
