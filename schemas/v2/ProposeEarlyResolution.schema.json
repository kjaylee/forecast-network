{
  "$comment": "Structural contract. Decode through the domain boundary to enforce semantic invariants.",
  "$defs": {
    "AIProvenance": {
      "additionalProperties": false,
      "properties": {
        "created_at_ms": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "input_hash": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "model": {
          "maxLength": 1000000,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "model_version": {
          "maxLength": 1000000,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "output_hash": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "policy_version": {
          "maxLength": 1000000,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "provider": {
          "maxLength": 1000000,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "task": {
          "enum": [
            "MARKET_COMPILER",
            "AMBIGUITY_JUDGE",
            "DUPLICATE_DETECTOR",
            "SOURCE_VERIFIER",
            "EVIDENCE_COLLECTOR",
            "RESOLUTION_JUDGE",
            "COUNTER_JUDGE",
            "DISPUTE_ANALYST",
            "INDEPENDENT_REJUDGE",
            "ADJUDICATION"
          ],
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "task",
        "provider",
        "model",
        "model_version",
        "policy_version",
        "input_hash",
        "output_hash",
        "created_at_ms"
      ],
      "type": "object"
    },
    "EarlyResolution": {
      "additionalProperties": false,
      "properties": {
        "confidence_bp": {
          "maximum": 10000,
          "minimum": 0,
          "type": "integer"
        },
        "conflict_explanation": {
          "anyOf": [
            {
              "maxLength": 1000000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "conflict_status": {
          "enum": [
            "CLEAR",
            "RESOLVED",
            "UNRESOLVED"
          ],
          "type": "string"
        },
        "counter_judge": {
          "$ref": "#/$defs/AIProvenance"
        },
        "counter_judge_agrees": {
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceSnapshot"
          },
          "minItems": 1,
          "type": "array"
        },
        "forecast_id": {
          "maxLength": 1000000,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])",
          "type": "string"
        },
        "judge": {
          "$ref": "#/$defs/AIProvenance"
        },
        "proposed_at_ms": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "proposed_outcome": {
          "enum": [
            "YES",
            "NO",
            "INVALID"
          ],
          "type": "string"
        },
        "reason_summary": {
          "maxLength": 1000000,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "rule_conflicts": {
          "items": {
            "maxLength": 1000000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "rule_matches": {
          "items": {
            "maxLength": 1000000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "schema_version": {
          "const": 2,
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "source_verifications": {
          "items": {
            "$ref": "#/$defs/SourceVerification"
          },
          "minItems": 1,
          "type": "array"
        },
        "specification_hash": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "trigger": {
          "$ref": "#/$defs/EarlyResolutionTrigger"
        }
      },
      "required": [
        "schema_version",
        "forecast_id",
        "specification_hash",
        "proposed_outcome",
        "confidence_bp",
        "evidence",
        "source_verifications",
        "rule_matches",
        "rule_conflicts",
        "reason_summary",
        "judge",
        "counter_judge",
        "counter_judge_agrees",
        "conflict_status",
        "proposed_at_ms",
        "conflict_explanation",
        "trigger"
      ],
      "type": "object"
    },
    "EarlyResolutionTrigger": {
      "additionalProperties": false,
      "properties": {
        "clause_id": {
          "maxLength": 1000000,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])",
          "type": "string"
        },
        "conditions_fully_satisfied": {
          "const": true
        },
        "counter_qualifier": {
          "$ref": "#/$defs/AIProvenance"
        },
        "event_at_ms": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "event_time_basis": {
          "enum": [
            "published_instant",
            "observed_upper_bound"
          ]
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceSnapshot"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        },
        "forecast_id": {
          "maxLength": 1000000,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])",
          "type": "string"
        },
        "invalidation_clear": {
          "const": true
        },
        "irreversible": {
          "const": true
        },
        "monotonic_kind": {
          "const": "official_announcement_by_deadline"
        },
        "observed_at_ms": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "proposed_outcome": {
          "const": "YES"
        },
        "qualification": {
          "maxLength": 1000000,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "qualifier": {
          "$ref": "#/$defs/AIProvenance"
        },
        "schema_version": {
          "const": 2,
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "source_verifications": {
          "items": {
            "$ref": "#/$defs/SourceVerification"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        },
        "specification_hash": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "forecast_id",
        "specification_hash",
        "clause_id",
        "evidence",
        "source_verifications",
        "event_at_ms",
        "observed_at_ms",
        "qualification",
        "qualifier",
        "counter_qualifier",
        "event_time_basis",
        "monotonic_kind",
        "proposed_outcome",
        "irreversible",
        "conditions_fully_satisfied",
        "invalidation_clear"
      ],
      "type": "object"
    },
    "EvidenceSnapshot": {
      "additionalProperties": false,
      "properties": {
        "collected_at_ms": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "collector": {
          "anyOf": [
            {
              "$ref": "#/$defs/AIProvenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "content_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "evidence_id": {
          "maxLength": 1000000,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "snapshot_uri": {
          "maxLength": 1000000,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "source_id": {
          "maxLength": 1000000,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])",
          "type": "string"
        },
        "url": {
          "maxLength": 1000000,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "evidence_id",
        "source_id",
        "url",
        "content_sha256",
        "snapshot_uri",
        "collected_at_ms",
        "collector"
      ],
      "type": "object"
    },
    "ProposeEarlyResolution": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "propose_resolution"
        },
        "resolution": {
          "$ref": "#/$defs/EarlyResolution"
        },
        "schema_version": {
          "const": 2,
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "resolution",
        "kind"
      ],
      "type": "object"
    },
    "SourceVerification": {
      "additionalProperties": false,
      "properties": {
        "evidence_hash": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "explanation": {
          "maxLength": 1000000,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "source_id": {
          "maxLength": 1000000,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])",
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        },
        "verifier": {
          "$ref": "#/$defs/AIProvenance"
        }
      },
      "required": [
        "schema_version",
        "evidence_hash",
        "source_id",
        "verified",
        "explanation",
        "verifier"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.forecast.network/v2/ProposeEarlyResolution.schema.json",
  "$ref": "#/$defs/ProposeEarlyResolution",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProposeEarlyResolution"
}
